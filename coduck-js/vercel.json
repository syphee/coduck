{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/coduck_bot.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/coduckAPI"
    },
    {
      "source": "/telegram/webhook",
      "destination": "/api/coduck_bot"
    },
    {
      "source": "/",
      "destination": "/api/coduck_bot"
    },
    {
      "source": "/api/reset",
      "destination": "/api/coduckAPI"
    }
  ]
}

