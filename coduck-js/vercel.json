{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/coduck_bot.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [

    {
      "source": "/telegram/webhook",
      "destination": "/api/coduck_bot"
    },
    {
      "source": "/",
      "destination": "/api/coduck_bot"
    },
    
    {
      "source": "/api/chat",
      "destination": "/api/coduckAPI"
    },
    {
      "source": "/api/reset",
      "destination": "/api/coduckAPI"
    },

    {
      "source":"/api/data/ping",
      "destination":"/api/dataAPI"
    },
    {
      "source":"/api/data/allUsers",
      "destination":"/api/dataAPI"
    },

    {
      "source":"/api/auth",
      "destination":"/api/authAPI"
    }
    

  ]
}

